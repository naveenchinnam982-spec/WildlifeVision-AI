# ====================================================================
# WildlifeVision AI — Environment Configuration Example
# ====================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# FOR NETLIFY DEPLOYMENT:
# Add GEMINI_API_KEY under:
#   Netlify Dashboard > Site Configuration > Environment Variables
#
# DO NOT commit real secrets or production keys to version control.
# ====================================================================

# Google Gemini API Key (Required for aerial drone CV detection and video tracking)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Express Server Port (Optional for local server, default: 3000)
PORT=3000

# Node Environment (Optional, 'development' or 'production', default: development)
NODE_ENV=development

# Gemini Computer Vision Model (Optional, default: gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemini-3.1-flash-lite, gemini-flash-latest
GEMINI_MODEL=gemini-3.8-flash

# Base App URL (Optional, default: http://localhost:3000)
APP_URL="http://localhost:3000"
